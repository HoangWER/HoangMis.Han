    elseif input.KeyCode == Enum.KeyCode.End or input.KeyCode == Config.StopKeybind then
        UnloadScript()
    end
end))

ShowNotification("HoangWER FISHING V2.0", "Script đã sẵn sàng! Nhấn R-CTRL để mở menu.", "SUCCESS", 5)
