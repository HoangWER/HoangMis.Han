local SKILL_KEYS = {"Z", "X", "C", "V"}

local function FireSkillKey(key)
    if not isRunning then return end
    if Events then
        if Events:FindFirstChild("UseSkill") then
            pcall(function() Events.UseSkill:FireServer(key) end)
        end
        if Events:FindFirstChild("TriggerMinigameSkill") then
            pcall(function() Events.TriggerMinigameSkill:FireServer(key) end)
        end
        if Events:FindFirstChild("Skill") then
            pcall(function() Events.Skill:FireServer(key) end)
        end
    end
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        if vim then
            vim:SendKeyEvent(true, Enum.KeyCode[key], false, game)
            task.wait(0.02)
            vim:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        end
    end)
end

local function UseAllSkills()
    if not isRunning then return end
    for _, k in ipairs(SKILL_KEYS) do
        if Config["Skill" .. k] then
            FireSkillKey(k)
        end
    end
end

